# Copy to .env.local for local development (never commit real values).
# Generate secrets with:  openssl rand -base64 48

NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authapi

# Two DIFFERENT strong secrets (>= 32 chars). Rotating them invalidates all tokens / integration secrets.
JWT_MASTER_SECRET=
INTEGRATION_MASTER_SECRET=

# Token issuer (iss claim). Production: your public HTTPS base URL, e.g. https://auth.xyz.com
JWT_ISSUER=http://localhost:3000

# Optional tuning
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INTEGRATION_TIMEOUT_MS=5000
LOG_LEVEL=info

# Required in production. Without it (dev only) an in-memory, single-process limiter is used.
REDIS_URL=

# Required in production: RapidAPI Studio -> your API -> Gateway / Security -> "X-RapidAPI-Proxy-Secret"
RAPIDAPI_PROXY_SECRET=

# Comma-separated browser origins allowed by CORS (empty = no CORS; API is server-to-server).
CORS_ALLOWED_ORIGINS=

# DEV/TEST ONLY: allow http:// and localhost/private integration URLs. Refused in production.
INTEGRATION_ALLOW_PRIVATE_URLS=false
